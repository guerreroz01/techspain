---
import Analytics from '@vercel/analytics/astro';
import { SITE, CONSENT, CONSENT_ACTIVE, ADS, ADS_ACTIVE, BRAND } from '../consts';
import Header from '../components/Header.astro';
import SearchBar from '../components/SearchBar.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import GoogleAds from '../components/GoogleAds.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /**
   * Social card. Defaults to the branded `BRAND.socialBanner`, so every page
   * ships an `og:image`: before that default existed, `/`, `/noticias/` and
   * `/acerca` emitted none and fell back to a small `summary` card.
   */
  image?: string;
  type?: string;
  /**
   * Emits `<meta name="robots" content="noindex, follow">`. Used by the legal
   * pages (`/aviso-legal`, `/privacidad`, `/cookies`), which are also filtered
   * out of the sitemap in `astro.config.mjs`.
   *
   * These paths are deliberately NOT disallowed in `public/robots.txt`: a
   * crawler that is blocked from fetching the page never reads this tag, so
   * disallowing would keep the URLs eligible for indexing as bare links. The
   * meta tag is the mechanism that actually keeps them out of the index.
   */
  noindex?: boolean;
  /**
   * `<html lang>` override. Defaults to `SITE.lang` (`es`); the English
   * article route passes `en` so assistive tech and crawlers see the real
   * page language.
   */
  lang?: string;
  /**
   * `og:locale` override. Defaults to `es_ES`; English pages pass `en_US`.
   */
  ogLocale?: string;
}

const {
  title,
  description = SITE.description,
  image = BRAND.socialBanner,
  type = 'website',
  noindex = false,
  lang = SITE.lang,
  ogLocale = 'es_ES',
} = Astro.props;

/**
 * Google truncates a `<title>` at roughly 60 characters. This corpus has a
 * median headline of 84 (max 138), so most headlines lose their distinguishing
 * words — usually the product name — in the SERP.
 *
 * `serpTitle` derives a concise `<title>` from the headline without touching the
 * on-page `<h1>`: keep the first clause when it is substantial, otherwise cut on
 * a word boundary. The full headline still drives Open Graph and Twitter cards.
 */
const TITLE_MAX = 60;
const TITLE_MIN = 25;

function serpTitle(value: string, max = TITLE_MAX): string {
  const clause = (value.split(/\s*[:|—–]\s*/)[0] ?? '').trim();
  const base = clause.length >= TITLE_MIN && clause.length <= max ? clause : value;
  if (base.length <= max) return base;

  const cut = base.slice(0, max);
  const atWord = cut.slice(0, cut.lastIndexOf(' '));
  return (atWord.length >= TITLE_MIN ? atWord : cut).replace(/[\s,;:.·-]+$/, '');
}

const brandedTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const conciseTitle = title ? serpTitle(title) : null;
const withBrand = conciseTitle ? `${conciseTitle} | ${SITE.title}` : SITE.title;
// Keep the brand only when it still fits; otherwise the words that earn the
// click matter more than the site name (Google often appends it anyway).
const pageTitle = withBrand.length <= 65 ? withBrand : (conciseTitle ?? SITE.title);
const siteBase = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, siteBase).href;
const ogImage = new URL(image, siteBase).href;
const rssHref = new URL('rss.xml', siteBase).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/*
      Indexable pages opt into large image previews. Google Discover requires
      `max-image-preview:large`; without it the article is not eligible for the
      large card, which is the main discovery surface for a news site that has
      no domain authority yet. Legal pages keep their `noindex, follow`.
    */}
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={brandedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={brandedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} — RSS`}
      href={rssHref}
    />

    <!--
      AdSense site-ownership verification. AdSense requires its code (or this
      meta tag) inside <head> to connect the site, but its crawler does not
      accept the cookie notice, so the consent-gated loader in `GoogleAds.astro`
      is invisible to it. This meta tag sets no cookie and needs no consent, so
      it is emitted on every page while the ad loader stays gated.
    -->
    {ADS_ACTIVE && <meta name="google-adsense-account" content={ADS.client} />}

    <!-- Per-page structured data (e.g. NewsArticle JSON-LD). -->
    <slot name="head" />

    <!--
      Anti-flash theme init. Runs before paint so the correct palette is applied
      immediately. Reads a saved preference first, then falls back to the OS.
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme =
            stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
          document.documentElement.dataset.theme = theme;
        } catch {
          // Ignore (private mode, disabled storage): the CSS fallback still applies.
        }
      })();
    </script>

    <!--
      Cookie-consent init. Runs before paint so the notice state is correct on
      the first frame, and it is the single place where the stored decision is
      parsed and the legacy binary key (`consent-analytics`) is migrated. Fail
      closed: if storage is unavailable we show the notice and load nothing.

      The resolved state is shared through `window.__consent.state` so the GA4,
      AdSense and preferences scripts never re-implement the migration.
    -->
    {
      CONSENT_ACTIVE && (
        <script is:inline define:vars={{ storageKey: CONSENT.storageKey, legacyKey: CONSENT.legacyKey }}>
          (() => {
            const root = document.documentElement;

            // Returns the stored decision or null when there is none yet.
            const readState = () => {
              try {
                const raw = localStorage.getItem(storageKey);
                if (raw) {
                  const parsed = JSON.parse(raw);
                  if (parsed && typeof parsed === 'object') {
                    return {
                      necessary: true,
                      analytics: parsed.analytics === true,
                      advertising: parsed.advertising === true,
                      updatedAt: typeof parsed.updatedAt === 'string' ? parsed.updatedAt : null,
                    };
                  }
                }

                // Migration: the previous notice stored a single binary value.
                const legacy = localStorage.getItem(legacyKey);
                if (legacy !== 'granted' && legacy !== 'denied') return null;

                const migrated = {
                  necessary: true,
                  analytics: legacy === 'granted',
                  advertising: false,
                  updatedAt: new Date().toISOString(),
                };
                localStorage.setItem(storageKey, JSON.stringify(migrated));
                localStorage.removeItem(legacyKey);
                return migrated;
              } catch {
                // Storage unavailable (private mode): behave as undecided.
                return null;
              }
            };

            const state = readState();

            // Shared with the GA4/AdSense loaders and the preferences dialog.
            window.__consent = { state, storageKey };

            // `pending` shows the notice (CSS-driven); `set` hides it.
            root.dataset.consent = state ? 'set' : 'pending';
          })();
        </script>
      )
    }

    <!--
      Google Analytics 4. Only injects the Google tag after the visitor accepts
      the analytics category; no request is made and no cookie is set before that.
    -->
    <GoogleAnalytics />

    <!--
      Google AdSense. Inert until `ADS.enabled` is true; when it is, the loader
      only injects after the visitor accepts the advertising category.
    -->
    <GoogleAds />

    <!--
      Vercel Web Analytics. Requires Analytics to be enabled for the project in
      the Vercel dashboard; the tracking routes are added on the next deploy.
    -->
    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <Header />

    <SearchBar />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <ConsentBanner />
  </body>
</html>
