---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleViewEn from '../../../components/ArticleViewEn.astro';
import VerticalHub from '../../../components/VerticalHub.astro';
import { computeStats, randomFor, relatedFor } from '../../../lib/related';
import { VERTICALS, articlesByVertical } from '../../../lib/verticals';

/**
 * `/en/news/<one-segment>/` mirrors the Spanish `[slug].astro`: it serves the
 * legacy flat English articles AND the English vertical hubs, because both are
 * one named segment. Nested English articles live in `[vertical]/[slug].astro`.
 */
export async function getStaticPaths() {
  const allEn = await getCollection('newsEn');
  const allEs = await getCollection('news');
  const esById = new Map(allEs.map((entry) => [entry.id, entry]));

  // Fail loudly when an English article's `translationOf` does not resolve to a
  // Spanish counterpart: an EN page without its ES source breaks the hreflang
  // pair this feature exists to provide. This is a content error, not a runtime
  // condition — there is nothing to recover from at request time.
  for (const entry of allEn) {
    if (!esById.has(entry.data.translationOf)) {
      throw new Error(
        `news-en/${entry.id}: translationOf "${entry.data.translationOf}" has no matching entry in src/content/news/`,
      );
    }
  }

  // Draft semantics mirror the Spanish route: drafts render in dev but are
  // excluded from production. Additionally, in production an English article is
  // hidden while its Spanish counterpart is a draft.
  const visible = allEn.filter((entry) => {
    if (!import.meta.env.PROD) return true;
    if (entry.data.draft) return false;
    return !esById.get(entry.data.translationOf)!.draft;
  });

  // Recommendation scoring runs over the ENGLISH corpus only (see related.ts).
  const stats = computeStats(visible);

  const flat = visible.filter((entry) => !entry.id.includes('/'));

  const flatIds = new Set(flat.map((entry) => entry.id));
  for (const vertical of VERTICALS) {
    if (flatIds.has(vertical.token)) {
      throw new Error(
        `Legacy English article "${vertical.token}" collides with the hub URL /en/news/${vertical.token}/. Rename the article slug.`,
      );
    }
  }

  const articles = flat.map((entry) => {
    const related = relatedFor(entry, visible, stats);
    return {
      params: { slug: entry.id },
      props: {
        kind: 'article' as const,
        entry,
        related,
        random: randomFor(entry, related, visible),
      },
    };
  });

  const esVisible = allEs.filter((entry) =>
    import.meta.env.PROD ? !entry.data.draft : true,
  );

  const hubs = VERTICALS.flatMap((vertical) => {
    const entries = articlesByVertical(visible, vertical.token, 'en');
    if (entries.length === 0) return [];
    return [
      {
        params: { slug: vertical.token },
        props: {
          kind: 'hub' as const,
          vertical: vertical.token,
          entries,
          hasAlt: articlesByVertical(esVisible, vertical.token, 'es').length > 0,
        },
      },
    ];
  });

  return [...hubs, ...articles];
}

type Props =
  | {
      kind: 'article';
      entry: CollectionEntry<'newsEn'>;
      related: CollectionEntry<'newsEn'>[];
      random: CollectionEntry<'newsEn'>[];
    }
  | {
      kind: 'hub';
      vertical: string;
      entries: CollectionEntry<'newsEn'>[];
      hasAlt: boolean;
    };

const props = Astro.props;
---

{
  props.kind === 'article' ? (
    <ArticleViewEn entry={props.entry} related={props.related} random={props.random} />
  ) : (
    <VerticalHub
      vertical={props.vertical}
      entries={props.entries}
      lang="en"
      basePath="/en/news/"
      locale="en-US"
      hasAlt={props.hasAlt}
      backHref="/"
      backLabel="← Back to TechSpain24"
    />
  )
}
