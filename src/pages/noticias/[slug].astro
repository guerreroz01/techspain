---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import StoryList from '../../components/StoryList.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const allNews = await getCollection('news');

  // Draft semantics are identical to the rest of the site: drafts render in dev
  // but are excluded from production builds, feeds and sitemaps.
  const visible = allNews.filter((entry) =>
    import.meta.env.PROD ? !entry.data.draft : true,
  );

  // Tag comparison is normalized (trimmed + lowercased) because the corpus has
  // real casing and fragmentation defects ('Inteligencia Artificial' vs
  // 'Inteligencia artificial', 'Nintendo' vs 'Nintendo Switch'). Normalizing at
  // comparison time keeps the article files untouched.
  const normalizeTag = (tag: string) => tag.trim().toLowerCase();

  // Each entry's normalized tag set is built exactly once, never per pair.
  const tagSets = new Map<string, Set<string>>();
  for (const entry of visible) {
    tagSets.set(entry.id, new Set(entry.data.tags.map(normalizeTag)));
  }

  // Document frequency: how many visible entries carry each normalized tag.
  const documentFrequency = new Map<string, number>();
  for (const tags of tagSets.values()) {
    for (const tag of tags) {
      documentFrequency.set(tag, (documentFrequency.get(tag) ?? 0) + 1);
    }
  }

  const total = visible.length;

  // Inverse-document-frequency weight. A rare tag ('AX Gaming', df=1) weighs far
  // more than a broad vertical ('Consolas', df=53), so no "brand beats vertical"
  // rule needs to be hardcoded. Guarded against an empty corpus.
  const tagWeight = (tag: string) => {
    const df = documentFrequency.get(tag) ?? 0;
    return df > 0 && total > 0 ? Math.log(total / df) : 0;
  };

  const slugTokens = new Map<string, string[]>();
  for (const entry of visible) {
    slugTokens.set(entry.id, entry.id.split('-'));
  }

  // Shared leading hyphen-separated tokens between two slugs, e.g.
  // `iphone-18-pro-teardown-critique` vs `iphone-18-pro-1tb-qlc` -> 3.
  const sharedPrefixLength = (a: string, b: string) => {
    const aTokens = slugTokens.get(a) ?? [];
    const bTokens = slugTokens.get(b) ?? [];
    const max = Math.min(aTokens.length, bTokens.length);
    let shared = 0;
    while (shared < max && aTokens[shared] === bTokens[shared]) shared++;
    return shared;
  };

  // Rewards real slug families (iphone-18-pro-*, oppo-find-x10-*, ...).
  const slugFamilyBonus = (shared: number) => (shared >= 3 ? 1.5 : shared === 2 ? 0.5 : 0);

  const relatedFor = (entry: CollectionEntry<'news'>): CollectionEntry<'news'>[] => {
    const tags = tagSets.get(entry.id) ?? new Set<string>();

    // An entry with no tags has nothing editorial to match on. Return empty
    // rather than matching on the slug bonus alone.
    if (tags.size === 0) return [];

    return visible
      .filter((candidate) => candidate.id !== entry.id)
      .map((candidate) => {
        const candidateTags = tagSets.get(candidate.id) ?? new Set<string>();
        let score = 0;
        for (const tag of tags) {
          if (candidateTags.has(tag)) score += tagWeight(tag);
        }
        score += slugFamilyBonus(sharedPrefixLength(entry.id, candidate.id));
        return { candidate, score };
      })
      .filter((scored) => scored.score > 0)
      .sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score;
        return b.candidate.data.pubDate.valueOf() - a.candidate.data.pubDate.valueOf();
      })
      .slice(0, 3)
      .map((scored) => scored.candidate);
  };

  // Fisher–Yates shuffle over a copy, so the input array is never mutated.
  const shuffle = <T,>(input: T[]): T[] => {
    const result = [...input];
    for (let i = result.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [result[i], result[j]] = [result[j], result[i]];
    }
    return result;
  };

  // Random recommendations, resolved at BUILD TIME ONLY. This is a static build:
  // Math.random() runs here in getStaticPaths, so the trio is frozen into the
  // generated HTML until the next deploy. Two builds of identical content will
  // legitimately differ — that non-determinism is intentional, not a bug, and
  // must not be "fixed" by making it deterministic. Per-visit randomness would
  // require client-side JavaScript and is forbidden (AGENTS.md §1 and §14).
  const randomFor = (
    entry: CollectionEntry<'news'>,
    related: CollectionEntry<'news'>[],
  ): CollectionEntry<'news'>[] => {
    // Exclude the entry itself and every article already shown in the related
    // block, so the two blocks on one page can never link the same article twice.
    const excluded = new Set<string>([entry.id, ...related.map((item) => item.id)]);
    const pool = visible.filter((candidate) => !excluded.has(candidate.id));
    return shuffle(pool).slice(0, 3);
  };

  return visible.map((entry) => {
    const related = relatedFor(entry);
    return {
      params: { slug: entry.id },
      props: { entry, related, random: randomFor(entry, related) },
    };
  });
}

interface Props {
  entry: CollectionEntry<'news'>;
  related: CollectionEntry<'news'>[];
  random: CollectionEntry<'news'>[];
}

const { entry, related, random } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, cover, coverAlt, source } =
  entry.data;

const { Content } = await render(entry);

const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedDate = dateFormatter.format(pubDate);
const formattedUpdated = updatedDate ? dateFormatter.format(updatedDate) : undefined;

const siteBase = Astro.site ?? new URL(SITE.url);
const canonical = new URL(`/noticias/${entry.id}/`, siteBase).href;
const coverSrc = cover?.src;
const image = coverSrc ? new URL(coverSrc, siteBase).href : undefined;

// Tutorials live in the same `news` collection but are how-to guides, not news,
// so they must not be typed as NewsArticle. `Article` is the correct parent
// type: Google retired HowTo rich results in 2023, so emitting a `HowTo` shape
// would buy nothing and force a brittle `step` array parsed from the body.
const articleType = tags[0] === 'Tutoriales' ? 'Article' : 'NewsArticle';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': articleType,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.title,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  inLanguage: 'es',
  ...(image ? { image: [image] } : {}),
};
---

<BaseLayout title={title} description={description} type="article" image={coverSrc}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="article container container--wide">
    <header class="article__header">
      {
        tags.length > 0 && (
          <ul class="article__tags" aria-label="Temas">
            {tags.map((tag) => (
              <li class="article__tag">{tag}</li>
            ))}
          </ul>
        )
      }

      <h1 class="article__title">{title}</h1>

      <p class="article__meta">
        <span class="article__author">{author}</span>
        {' · '}
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {
          updatedDate && formattedUpdated && (
            <span class="article__updated">
              {' · '}Actualizado el{' '}
              <time datetime={updatedDate.toISOString()}>{formattedUpdated}</time>
            </span>
          )
        }
      </p>
    </header>

    {
      cover ? (
        <figure class="article__figure">
          <img
            class="article__cover"
            src={coverSrc}
            alt={coverAlt ?? ''}
            loading="eager"
            decoding="async"
          />
        </figure>
      ) : (
        <div class="article__placeholder" aria-hidden="true">
          <svg
            class="article__placeholder-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
          </svg>
          <span>Sin imagen</span>
        </div>
      )
    }

    <article class="prose article__body">
      <Content />
    </article>

    {
      source && (
        <aside class="article__source" aria-label="Fuente">
          <p>
            Fuente:{' '}
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.name}
            </a>
          </p>
        </aside>
      )
    }

    <StoryList id="related-title" title="Noticias relacionadas" entries={related} />

    <AdSlot />

    <nav class="article__back" aria-label="Volver a noticias">
      <a href="/noticias/">← Volver a noticias</a>
    </nav>

    <StoryList id="random-title" title="Otras noticias" entries={random} />
  </div>
</BaseLayout>

<style>
  .article__header {
    padding-block: var(--space-8) var(--space-5);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-4);
  }

  .article__tag {
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .article__title {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-tight);
  }

  .article__meta {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .article__figure {
    margin: 0 0 var(--space-6);
  }

  .article__cover,
  .article__placeholder {
    width: 100%;
    aspect-ratio: var(--aspect-cover);
    border-radius: var(--radius-lg);
  }

  .article__cover {
    object-fit: cover;
  }

  .article__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    background-color: var(--color-surface);
    border: var(--border-width) dashed var(--color-border);
    color: var(--color-text-muted);
  }

  .article__placeholder-icon {
    width: var(--space-6);
    height: var(--space-6);
    stroke-width: var(--icon-stroke);
  }

  .article__placeholder span {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .article__body {
    margin-bottom: var(--space-6);
  }

  .article__source {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background-color: var(--color-surface);
    border-left: var(--space-1) solid var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .article__source p {
    margin: 0;
  }

  .article__back {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }
</style>
