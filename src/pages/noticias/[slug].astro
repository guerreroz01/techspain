---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleView from '../../components/ArticleView.astro';
import VerticalHub from '../../components/VerticalHub.astro';
import { computeStats, randomFor, relatedFor } from '../../lib/related';
import { VERTICALS, articlesByVertical } from '../../lib/verticals';

/**
 * `/noticias/<one-segment>/` is shared by two page kinds:
 *   - a legacy flat article -> `/noticias/<slug>/`
 *   - a vertical hub        -> `/noticias/<vertical>/`
 *
 * Both are one named segment, so they MUST be generated from this single route:
 * two files with the same pattern would be ambiguous. New nested articles
 * (`/noticias/<vertical>/<slug>/`) are served by `[vertical]/[slug].astro`, and
 * archive pagination (`/noticias/2/`) by `[...page].astro` (named params beat
 * rest params, so this route wins over `[...page]` for the paths it declares).
 */
export async function getStaticPaths() {
  const allNews = await getCollection('news');

  // Draft semantics are identical to the rest of the site: drafts render in dev
  // but are excluded from production builds, feeds and sitemaps.
  const visible = allNews.filter((entry) =>
    import.meta.env.PROD ? !entry.data.draft : true,
  );

  // Recommendation scoring is shared (see `src/lib/related.ts`).
  const stats = computeStats(visible);

  // New nested articles (ids with `/`) are served by the sibling route.
  const flat = visible.filter((entry) => !entry.id.includes('/'));

  // A flat slug must never shadow a vertical token, or both page kinds would
  // declare the same path.
  const flatIds = new Set(flat.map((entry) => entry.id));
  for (const vertical of VERTICALS) {
    if (flatIds.has(vertical.token)) {
      throw new Error(
        `Legacy article "${vertical.token}" collides with the vertical hub URL /noticias/${vertical.token}/. Rename the article slug.`,
      );
    }
  }

  const articles = flat.map((entry) => {
    const related = relatedFor(entry, visible, stats);
    return {
      params: { slug: entry.id },
      props: {
        kind: 'article' as const,
        entry,
        related,
        random: randomFor(entry, related, visible),
      },
    };
  });

  // Hubs group nested entries by their id folder and legacy entries by their
  // primary tag. `hasAlt` drives the hreflang pair only when the English hub
  // actually exists (an alternate pointing at a 404 is worse than none).
  const enVisible = (await getCollection('newsEn')).filter((entry) =>
    import.meta.env.PROD ? !entry.data.draft : true,
  );

  const hubs = VERTICALS.flatMap((vertical) => {
    const entries = articlesByVertical(visible, vertical.token, 'es');
    if (entries.length === 0) return [];
    return [
      {
        params: { slug: vertical.token },
        props: {
          kind: 'hub' as const,
          vertical: vertical.token,
          entries,
          hasAlt: articlesByVertical(enVisible, vertical.token, 'en').length > 0,
        },
      },
    ];
  });

  return [...hubs, ...articles];
}

type Props =
  | {
      kind: 'article';
      entry: CollectionEntry<'news'>;
      related: CollectionEntry<'news'>[];
      random: CollectionEntry<'news'>[];
    }
  | {
      kind: 'hub';
      vertical: string;
      entries: CollectionEntry<'news'>[];
      hasAlt: boolean;
    };

const props = Astro.props;
---

{
  props.kind === 'article' ? (
    <ArticleView entry={props.entry} related={props.related} random={props.random} />
  ) : (
    <VerticalHub
      vertical={props.vertical}
      entries={props.entries}
      lang="es"
      basePath="/noticias/"
      locale="es-ES"
      hasAlt={props.hasAlt}
      backHref="/noticias/"
      backLabel="← Volver a todas las noticias"
    />
  )
}
