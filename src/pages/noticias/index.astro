---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SITE } from '../../consts';

const allNews = await getCollection('news');

const posts = allNews
  .filter((entry) => (import.meta.env.PROD ? !entry.data.draft : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Noticias"
  description={`Todas las noticias de tecnología publicadas en ${SITE.title}.`}
>
  <div class="container container--wide archive">
    <header class="archive__header">
      <h1 class="archive__title">Noticias</h1>
      <p class="archive__intro">
        Todas las noticias de tecnología publicadas en {SITE.title}, de la más reciente a la más
        antigua.
      </p>
    </header>

    {
      posts.length > 0 ? (
        <ul class="archive__list">
          {posts.map((entry) => (
            <li>
              <NewsCard entry={entry} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="archive__empty">Todavía no hay noticias publicadas.</p>
      )
    }

    <AdSlot />
  </div>
</BaseLayout>

<style>
  .archive__header {
    padding-block: var(--space-8) var(--space-6);
  }

  .archive__title {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-tight);
  }

  .archive__intro {
    max-width: var(--measure);
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .archive__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .archive__empty {
    padding-block: var(--space-7);
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
