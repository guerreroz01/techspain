---
import { SITE, SOCIAL, CONSENT_ACTIVE } from '../consts';
import { VERTICALS } from '../lib/verticals';

interface Props {
  /** Page language; selects the label set and the hub path prefix. */
  lang?: string;
}

const { lang = SITE.lang } = Astro.props;
const isEn = lang.startsWith('en');
const basePath = isEn ? '/en/news/' : '/noticias/';

/**
 * Vertical hubs were previously reachable only from an article's breadcrumb or
 * the sitemap: the header nav has no section links. A site-wide footer block
 * gives every page a path into all eleven sections, which is what builds the
 * topical clusters the sections are supposed to represent.
 */
const SECTIONS = VERTICALS.map((vertical) => ({
  label: isEn ? vertical.en : vertical.es,
  href: `${basePath}${vertical.token}/`,
}));

const year = new Date().getFullYear();

const LEGAL_LINKS = [
  { label: 'Aviso legal', href: '/aviso-legal' },
  { label: 'Privacidad', href: '/privacidad' },
  { label: 'Cookies', href: '/cookies' },
] as const;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__copy">© {year} {SITE.author}</p>

    <nav aria-label="Enlaces del sitio">
      <ul class="site-footer__links">
        {
          SOCIAL.map((item) => (
            <li>
              <a href={item.href} rel="me noopener noreferrer" target="_blank">
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href="/contacto">Contacto</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        {
          LEGAL_LINKS.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        {
          CONSENT_ACTIVE && (
            <li>
              <button id="consent-reopen" class="site-footer__consent" type="button">
                Configurar cookies
              </button>
            </li>
          )
        }
      </ul>
    </nav>

    <nav class="site-footer__sections" aria-label={isEn ? 'Sections' : 'Secciones'}>
      <ul class="site-footer__links">
        {
          SECTIONS.map((section) => (
            <li>
              <a href={section.href}>{section.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

{
  CONSENT_ACTIVE && (
    <script is:inline>
      (() => {
        const button = document.getElementById('consent-reopen');
        if (!button) return;

        button.addEventListener('click', () => {
          document.dispatchEvent(new CustomEvent('consent:reopen'));
        });
      })();
    </script>
  )
}

<style>
  .site-footer {
    margin-top: var(--space-9);
    border-top: var(--border-width) solid var(--color-border);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-6);
  }

  .site-footer__copy {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer__links a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .site-footer__links a:hover {
    color: var(--color-text);
  }

  /* Full-width row under the legal/social links: the eleven section hubs. */
  .site-footer__sections {
    width: 100%;
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
  }

  /* Matches the surrounding footer links; reopens the cookie notice. */
  .site-footer__consent {
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .site-footer__consent:hover {
    color: var(--color-text);
  }
</style>
