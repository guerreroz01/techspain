---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import StoryCard from './StoryCard.astro';

interface Props {
  lead: CollectionEntry<'news'>;
  secondary: CollectionEntry<'news'>[];
}

const { lead, secondary } = Astro.props;
const { title, description, pubDate, author, cover, coverAlt } = lead.data;

const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedDate = dateFormatter.format(pubDate);
const isoDate = pubDate.toISOString();
---

<section class="lead" aria-label="Noticia principal">
  <div class="container container--wide lead__grid">
    <article class="lead__main">
      {
        cover ? (
          <Image
            class="lead__image"
            src={cover}
            alt={coverAlt ?? ''}
            widths={[480, 720, 1080]}
            sizes="(min-width: 48rem) 33rem, 100vw"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="lead__placeholder">
            <svg
              class="lead__placeholder-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <path d="m21 15-5-5L5 21" />
            </svg>
            <span>Sin imagen</span>
          </div>
        )
      }

      <p class="lead__eyebrow">Noticia principal</p>
      <h1 class="lead__title">
        <a href={`/noticias/${lead.id}/`}>{title}</a>
      </h1>
      <p class="lead__description">{description}</p>
      <p class="lead__meta">
        <span>{author}</span>
        {' · '}
        <time datetime={isoDate}>{formattedDate}</time>
      </p>
    </article>

    {
      secondary.length > 0 && (
        <div class="lead__secondary">
          <h2 class="lead__secondary-title">También destacadas</h2>
          <ul class="lead__secondary-list">
            {secondary.map((entry) => (
              <li>
                <StoryCard entry={entry} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .lead {
    padding-block: var(--space-8) var(--space-6);
  }

  .lead__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  .lead__image,
  .lead__placeholder {
    width: 100%;
    aspect-ratio: var(--aspect-cover);
    border-radius: var(--radius-lg);
  }

  .lead__image {
    object-fit: cover;
  }

  .lead__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    background-color: var(--color-surface);
    border: var(--border-width) dashed var(--color-border);
    color: var(--color-text-muted);
  }

  .lead__placeholder-icon {
    width: var(--space-6);
    height: var(--space-6);
    stroke-width: var(--icon-stroke);
  }

  .lead__placeholder span {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .lead__eyebrow {
    margin-top: var(--space-5);
    color: var(--color-accent);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .lead__title {
    margin-top: var(--space-2);
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
  }

  .lead__title a {
    color: var(--color-text);
  }

  .lead__title a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .lead__description {
    max-width: var(--measure);
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .lead__meta {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .lead__secondary-title {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .lead__secondary-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .lead__grid {
      grid-template-columns: 1.3fr 1fr;
    }
  }
</style>
