---
import { SITE, NAV } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const NAV_ID = 'site-nav';
const NAV_TOGGLE_ID = 'nav-toggle';

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<script is:inline>
  // Progressive enhancement: the collapsed mobile menu only exists once this
  // script has run, and `<html data-nav="enhanced">` is the switch. If the
  // script never executes the marker is absent and the stylesheet keeps the
  // links in their always-visible layout, so a failure here can never take
  // navigation away from the page.
  //
  // This runs before the header markup below is parsed, so the marker is
  // already set when the nav first lays out: no flash of an expanded menu.
  document.documentElement.dataset.nav = 'enhanced';

  (() => {
    const navId = 'site-nav';
    const toggleId = 'nav-toggle';

    const init = () => {
      const nav = document.getElementById(navId);
      const toggle = document.getElementById(toggleId);
      if (!nav || !toggle) return;

      const isOpen = () => nav.hasAttribute('data-open');

      const setOpen = (open) => {
        toggle.setAttribute('aria-expanded', String(open));
        nav.toggleAttribute('data-open', open);
      };

      toggle.addEventListener('click', () => setOpen(!isOpen()));

      // Escape closes the menu and hands focus back to the control that opened
      // it, so keyboard users are never dropped into the page.
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !isOpen()) return;
        setOpen(false);
        toggle.focus();
      });

      // Tapping anywhere outside dismisses the panel.
      document.addEventListener('click', (event) => {
        if (!isOpen()) return;
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (nav.contains(target) || toggle.contains(target)) return;
        setOpen(false);
      });

      // Widening past the breakpoint restores the inline nav; drop the open
      // state so it cannot reappear stale when the viewport narrows again.
      const wide = window.matchMedia('(min-width: 48rem)');
      wide.addEventListener('change', (event) => {
        if (event.matches) setOpen(false);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">
      <img
        class="site-header__mark"
        src="/logo-mark-96.png"
        alt=""
        width="96"
        height="96"
        decoding="async"
      />
      <span class="site-header__wordmark">{SITE.title}</span>
    </a>

    <nav class="site-nav" id={NAV_ID} aria-label="Navegación principal">
      <ul class="site-nav__list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id={NAV_TOGGLE_ID}
      class="nav-toggle"
      type="button"
      aria-label="Menú"
      aria-controls={NAV_ID}
      aria-expanded="false"
    >
      <svg
        class="nav-toggle__icon nav-toggle__icon--open"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>

      <svg
        class="nav-toggle__icon nav-toggle__icon--close"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  /* Fixed mark, fluid wordmark. The mark is decorative: the link's accessible
   * name is the wordmark text, so the image carries an empty alt. */
  .site-header__mark {
    flex: 0 0 auto;
    width: var(--brand-mark-size);
    height: auto;
  }

  .site-header__brand:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .site-nav {
    margin-inline-start: auto;
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* Row gap only matters for the no-JS fallback, where the links wrap. */
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-nav__list a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .site-nav__list a:hover,
  .site-nav__list a[aria-current='page'] {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Collapse control. Hidden by default: it is only ever shown by the mobile
   * block below, which requires the script marker. */
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    margin-inline-start: auto;
    padding: var(--space-2);
    background-color: transparent;
    color: var(--color-text-muted);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .nav-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .nav-toggle__icon--close {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon--open {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon--close {
    display: block;
  }

  /* --- Collapsed mobile navigation --------------------------------------
   * Scoped to a scripted document AND to the narrow range, so the desktop row
   * above stays exactly as it was and the no-JS fallback keeps the links
   * visible. The panel is an overlay anchored under the header bar.
   */
  @media (max-width: 47.999rem) {
    :global(html[data-nav='enhanced']) .site-header__inner {
      position: relative;
      gap: var(--space-3);
    }

    :global(html[data-nav='enhanced']) .nav-toggle {
      display: inline-flex;
    }

    :global(html[data-nav='enhanced']) .site-nav {
      position: absolute;
      top: calc(100% + var(--border-width));
      inset-inline: 0;
      display: none;
      z-index: var(--z-nav-panel);
      margin-inline-start: 0;
      padding-inline: var(--space-5);
      padding-block: var(--space-2);
      background-color: var(--color-bg);
      box-shadow: var(--shadow-md);
    }

    :global(html[data-nav='enhanced']) .site-nav[data-open] {
      display: block;
    }

    :global(html[data-nav='enhanced']) .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-1);
    }

    :global(html[data-nav='enhanced']) .site-nav__list a {
      display: block;
      padding-block: var(--space-2);
    }
  }
</style>
