---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from './AdSlot.astro';
import StoryList from './StoryList.astro';
import { bylineFor } from '../lib/authors';
import { computeStats, randomFor, relatedFor } from '../lib/related';
import { verticalByToken, verticalTokenFromId } from '../lib/verticals';
import { BRAND, SITE, socialPoolImageFor } from '../consts';

interface Props {
  entry: CollectionEntry<'news'>;
  related: CollectionEntry<'news'>[];
  random: CollectionEntry<'news'>[];
}

const { entry, related, random } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, source } = entry.data;

// Byline from the vertical's writer; legacy flat entries fall back to SITE.author.
const byline = bylineFor(entry, 'es');

const { Content } = await render(entry);

const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedDate = dateFormatter.format(pubDate);
const formattedUpdated = updatedDate ? dateFormatter.format(updatedDate) : undefined;

const siteBase = Astro.site ?? new URL(SITE.url);
const canonical = new URL(`/noticias/${entry.id}/`, siteBase).href;

// Vertical hub link. Nested entries (`<vertical>/<slug>`) carry the vertical in
// their id; legacy flat entries have none, so they show no breadcrumb.
const verticalToken = verticalTokenFromId(entry.id);
const vertical = verticalToken ? verticalByToken(verticalToken) : undefined;
const hubPath = verticalToken ? `/noticias/${verticalToken}/` : null;

// English counterpart, if one exists: drives the hreflang pair in <head> and the
// visible "read in English" link. Draft EN entries never surface in production
// (mirrors how draft Spanish articles are excluded there); in dev they do, the
// same way draft Spanish articles render in dev.
const allEn = await getCollection('newsEn');
const enId = allEn.find(
  (candidate) =>
    candidate.data.translationOf === entry.id &&
    (import.meta.env.PROD ? !candidate.data.draft : true),
)?.id;
const enHref = enId ? new URL(`/en/news/${enId}/`, siteBase).href : undefined;

// Never feed `cover.src` to the output. Astro keys its asset bookkeeping by the
// image's output URL and only keeps an original whose recorded source path was
// referenced while rendering, so when another image in the same entry claims
// the same URL the cover's file is deleted and every reference to it 404s. An
// explicitly requested transform is always emitted, so the hero and the share
// card are built from those instead.
const heroImage = cover ? await getImage({ src: cover, width: 1200, format: 'webp' }) : undefined;
const shareImage = cover ? await getImage({ src: cover, width: 1200, format: 'jpeg' }) : undefined;

const image = shareImage ? new URL(shareImage.src, siteBase).href : undefined;

// Share card. `BaseLayout` already defaults to the branded banner, but an
// article deserves its own cover; when it has none it draws from the generic
// pool so the shared link is never bare and never borrows another article's
// photo. This is presentation only — `image` above stays the factual
// `Article.image` in the structured data and is omitted when there is no cover.
const socialImage = shareImage?.src ?? socialPoolImageFor(entry.id);

// Tutorials live in the same `news` collection but are how-to guides, not news,
// so they must not be typed as NewsArticle. `Article` is the correct parent
// type: Google retired HowTo rich results in 2023, so emitting a `HowTo` shape
// would buy nothing and force a brittle `step` array parsed from the body.
const articleType = tags[0] === 'Tutoriales' ? 'Article' : 'NewsArticle';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': articleType,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: byline,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.title,
    // Publisher logo, required for the organisation to be eligible for the
    // knowledge panel / rich results. Square 512x512 derivative of the mark.
    logo: {
      '@type': 'ImageObject',
      url: new URL(BRAND.logo, siteBase).href,
      width: 512,
      height: 512,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  inLanguage: 'es',
  ...(image ? { image: [image] } : {}),
};

const breadcrumbLd =
  vertical && hubPath
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Portada', item: new URL('/', siteBase).href },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Noticias',
            item: new URL('/noticias/', siteBase).href,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: vertical.es,
            item: new URL(hubPath, siteBase).href,
          },
          { '@type': 'ListItem', position: 4, name: title, item: canonical },
        ],
      }
    : undefined;
---

<BaseLayout title={title} description={description} type="article" image={socialImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    {
      enHref && (
        <>
          <link rel="alternate" hreflang="es" href={canonical} />
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="x-default" href={canonical} />
        </>
      )
    }
  </Fragment>

  <div class="article container container--wide">
    {
      vertical && hubPath && (
        <nav class="article__breadcrumb" aria-label="Miga de pan">
          <ol>
            <li>
              <a href="/">Portada</a>
            </li>
            <li>
              <a href="/noticias/">Noticias</a>
            </li>
            <li>
              <a href={hubPath}>{vertical.es}</a>
            </li>
            <li aria-current="page">{title}</li>
          </ol>
        </nav>
      )
    }

    <header class="article__header">
      {
        tags.length > 0 && (
          <ul class="article__tags" aria-label="Temas">
            {tags.map((tag) => (
              <li class="article__tag">{tag}</li>
            ))}
          </ul>
        )
      }

      <h1 class="article__title">{title}</h1>

      {
        enHref && (
          <p class="article__lang">
            <a href={new URL(`/en/news/${enId}/`, siteBase).pathname} hreflang="en">
              Este artículo también está disponible en inglés → Leer en inglés
            </a>
          </p>
        )
      }

      <p class="article__meta">
        <span class="article__author">{byline}</span>
        {' · '}
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {
          updatedDate && formattedUpdated && (
            <span class="article__updated">
              {' · '}Actualizado el{' '}
              <time datetime={updatedDate.toISOString()}>{formattedUpdated}</time>
            </span>
          )
        }
      </p>
    </header>

    {
      cover && heroImage ? (
        <figure class="article__figure">
          <img
            class="article__cover"
            src={heroImage.src}
            alt={coverAlt ?? ''}
            width={heroImage.attributes.width}
            height={heroImage.attributes.height}
            loading="eager"
            decoding="async"
          />
        </figure>
      ) : (
        <div class="article__placeholder" aria-hidden="true">
          <svg
            class="article__placeholder-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
          </svg>
          <span>Sin imagen</span>
        </div>
      )
    }

    <article class="prose article__body">
      <Content />
    </article>

    {
      source && (
        <aside class="article__source" aria-label="Fuente">
          <p>
            Fuente:{' '}
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.name}
            </a>
          </p>
        </aside>
      )
    }

    <StoryList id="related-title" title="Noticias relacionadas" entries={related} />

    <AdSlot />

    <nav class="article__back" aria-label="Volver a noticias">
      <a href="/noticias/">← Volver a noticias</a>
    </nav>

    <StoryList id="random-title" title="Otras noticias" entries={random} />
  </div>
</BaseLayout>

<style>
  .article__breadcrumb {
    padding-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .article__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .article__breadcrumb li + li::before {
    content: '›';
    margin-right: var(--space-2);
    color: var(--color-text-muted);
  }

  .article__breadcrumb [aria-current='page'] {
    color: var(--color-text-muted);
  }

  .article__header {
    padding-block: var(--space-8) var(--space-5);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-4);
  }

  .article__tag {
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .article__title {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-tight);
  }

  .article__lang {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .article__lang a {
    color: var(--color-accent);
  }

  .article__meta {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .article__figure {
    margin: 0 0 var(--space-6);
  }

  .article__cover,
  .article__placeholder {
    width: 100%;
    aspect-ratio: var(--aspect-cover);
    border-radius: var(--radius-lg);
  }

  .article__cover {
    object-fit: cover;
  }

  .article__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    background-color: var(--color-surface);
    border: var(--border-width) dashed var(--color-border);
    color: var(--color-text-muted);
  }

  .article__placeholder-icon {
    width: var(--space-6);
    height: var(--space-6);
    stroke-width: var(--icon-stroke);
  }

  .article__placeholder span {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .article__body {
    margin-bottom: var(--space-6);
  }

  .article__source {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background-color: var(--color-surface);
    border-left: var(--space-1) solid var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .article__source p {
    margin: 0;
  }

  .article__back {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }
</style>
