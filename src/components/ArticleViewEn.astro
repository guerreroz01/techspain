---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from './AdSlot.astro';
import StoryList from './StoryList.astro';
import { BRAND, SITE, socialPoolImageFor } from '../consts';
import { bylineFor } from '../lib/authors';
import { verticalByToken, verticalTokenFromId } from '../lib/verticals';

interface Props {
  entry: CollectionEntry<'newsEn'>;
  related: CollectionEntry<'newsEn'>[];
  random: CollectionEntry<'newsEn'>[];
}

const { entry, related, random } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, source, translationOf } =
  entry.data;

// Same writer as the Spanish original; legacy flat entries fall back to the
// English staff byline.
const byline = bylineFor(entry, 'en');

const { Content } = await render(entry);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedDate = dateFormatter.format(pubDate);
const formattedUpdated = updatedDate ? dateFormatter.format(updatedDate) : undefined;

const siteBase = Astro.site ?? new URL(SITE.url);
const canonical = new URL(`/en/news/${entry.id}/`, siteBase).href;
const esCanonical = new URL(`/noticias/${translationOf}/`, siteBase).href;

// Vertical hub link for nested entries (`<vertical>/<english-slug>`).
const verticalToken = verticalTokenFromId(entry.id);
const vertical = verticalToken ? verticalByToken(verticalToken) : undefined;
const hubPath = verticalToken ? `/en/news/${verticalToken}/` : null;

// Same image rules as the Spanish route: never render `cover.src` directly —
// request an explicit transform so Astro's asset bookkeeping keeps the file
// alive (AGENTS.md §14, "Never render cover.src").
const heroImage = cover ? await getImage({ src: cover, width: 1200, format: 'webp' }) : undefined;
const shareImage = cover ? await getImage({ src: cover, width: 1200, format: 'jpeg' }) : undefined;

const image = shareImage ? new URL(shareImage.src, siteBase).href : undefined;
const socialImage = shareImage?.src ?? socialPoolImageFor(entry.id);

// Same typing rule as the Spanish route: tutorials are `Article`, not
// `NewsArticle`. English tags use the English label ("Tutorials" first).
const articleType = tags[0] === 'Tutorials' ? 'Article' : 'NewsArticle';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': articleType,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: byline,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.title,
    logo: {
      '@type': 'ImageObject',
      url: new URL(BRAND.logo, siteBase).href,
      width: 512,
      height: 512,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  inLanguage: 'en',
  ...(image ? { image: [image] } : {}),
};

const breadcrumbLd =
  vertical && hubPath
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteBase).href },
          {
            '@type': 'ListItem',
            position: 2,
            name: vertical.en,
            item: new URL(hubPath, siteBase).href,
          },
          { '@type': 'ListItem', position: 3, name: title, item: canonical },
        ],
      }
    : undefined;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={socialImage}
  lang="en"
  ogLocale="en_US"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    <!--
      hreflang pair with the Spanish original. `x-default` points at the Spanish
      version: it is the site's primary language and the target for unset or
      unsupported language preferences.
    -->
    <link rel="alternate" hreflang="es" href={esCanonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={esCanonical} />
  </Fragment>

  <div class="article container container--wide">
    {
      vertical && hubPath && (
        <nav class="article__breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href="/">Home</a>
            </li>
            <li>
              <a href={hubPath}>{vertical.en}</a>
            </li>
            <li aria-current="page">{title}</li>
          </ol>
        </nav>
      )
    }

    <header class="article__header">
      {
        tags.length > 0 && (
          <ul class="article__tags" aria-label="Topics">
            {tags.map((tag) => (
              <li class="article__tag">{tag}</li>
            ))}
          </ul>
        )
      }

      <h1 class="article__title">{title}</h1>

      <p class="article__meta">
        <span class="article__author">{byline}</span>
        {' · '}
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {
          updatedDate && formattedUpdated && (
            <span class="article__updated">
              {' · '}Updated on{' '}
              <time datetime={updatedDate.toISOString()}>{formattedUpdated}</time>
            </span>
          )
        }
      </p>
    </header>

    {
      cover && heroImage ? (
        <figure class="article__figure">
          <img
            class="article__cover"
            src={heroImage.src}
            alt={coverAlt ?? ''}
            width={heroImage.attributes.width}
            height={heroImage.attributes.height}
            loading="eager"
            decoding="async"
          />
        </figure>
      ) : (
        <div class="article__placeholder" aria-hidden="true">
          <svg
            class="article__placeholder-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
          </svg>
          <span>No image</span>
        </div>
      )
    }

    <article class="prose article__body">
      <Content />
    </article>

    {
      source && (
        <aside class="article__source" aria-label="Source">
          <p>
            Source:{' '}
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.name}
            </a>
          </p>
        </aside>
      )
    }

    <StoryList
      id="related-title"
      title="Related news"
      entries={related}
      basePath="/en/news/"
      locale="en-US"
    />

    <AdSlot />

    <nav class="article__back" aria-label="Back to home">
      <a href="/">← Back to TechSpain24</a>
    </nav>

    <StoryList
      id="random-title"
      title="Other news"
      entries={random}
      basePath="/en/news/"
      locale="en-US"
    />
  </div>
</BaseLayout>

<style>
  .article__breadcrumb {
    padding-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .article__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .article__breadcrumb li + li::before {
    content: '›';
    margin-right: var(--space-2);
    color: var(--color-text-muted);
  }

  .article__breadcrumb [aria-current='page'] {
    color: var(--color-text-muted);
  }

  .article__header {
    padding-block: var(--space-8) var(--space-5);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-4);
  }

  .article__tag {
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .article__title {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-tight);
  }

  .article__meta {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .article__figure {
    margin: 0 0 var(--space-6);
  }

  .article__cover,
  .article__placeholder {
    width: 100%;
    aspect-ratio: var(--aspect-cover);
    border-radius: var(--radius-lg);
  }

  .article__cover {
    object-fit: cover;
  }

  .article__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background-color: var(--color-surface);
    border: var(--border-width) dashed var(--color-border);
    color: var(--color-text-muted);
  }

  .article__placeholder-icon {
    width: var(--space-6);
    height: var(--space-6);
    stroke-width: var(--icon-stroke);
  }

  .article__placeholder span {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .article__body {
    margin-bottom: var(--space-6);
  }

  .article__source {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background-color: var(--color-surface);
    border-left: var(--space-1) solid var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .article__source p {
    margin: 0;
  }

  .article__back {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }
</style>
