---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { title, pubDate, cover, coverAlt } = entry.data;

const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedDate = dateFormatter.format(pubDate);
const isoDate = pubDate.toISOString();
---

<article class="story-card">
  {
    cover && (
      <img
        class="story-card__thumb"
        src={cover.src}
        alt={coverAlt ?? ''}
        loading="lazy"
        decoding="async"
      />
    )
  }

  <div class="story-card__body">
    <h2 class="story-card__title">
      <a href={`/noticias/${entry.id}/`}>{title}</a>
    </h2>
    <time class="story-card__date" datetime={isoDate}>{formattedDate}</time>
  </div>
</article>

<style>
  .story-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
  }

  .story-card__thumb {
    flex: 0 0 auto;
    width: var(--thumb-width-sm);
    aspect-ratio: var(--aspect-thumb);
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .story-card__title {
    font-size: var(--text-base);
  }

  .story-card__title a {
    color: var(--color-text);
  }

  .story-card__title a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .story-card__date {
    display: block;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
</style>
